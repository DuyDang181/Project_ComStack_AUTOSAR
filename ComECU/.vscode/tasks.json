{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Make: build",
      "type": "shell",
      "command": "make",
      "args": [],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Make: clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Make: rebuild",
      "type": "shell",
      "command": "make",
      "args": ["clean", "all"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Renode: cleanup",
      "type": "shell",
      "command": "taskkill /F /IM renode.exe 2>nul & taskkill /F /IM mono.exe 2>nul & del /f /q tool\\logs\\*.log 2>nul & echo ✅ Environment cleaned",
      "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/c"
                    ]
                }
            },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Renode: start interactive",
      "type": "process",
      "command": "renode",
      "args": [
        "--disable-xwt",
        "-e",
        "include @Script/stm32_evcu_training.resc"
      ],
      "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/c"
                    ]
                }
            },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*System bus created.*$",
          "endsPattern": "^.*port :3334.*$"
        }
      },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Renode: Prepare & Run",
      "dependsOn": ["Renode: cleanup", "Make: rebuild", "Renode: start interactive"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Renode: start single node",
      "type": "process",
      "command": "renode",
      "args": [
        "--disable-xwt",
        "-e",
        "include @Script/stm32_evcu_training.resc"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*System bus created.*$",
          "endsPattern": "^.*port :3333.*$"
        }
      },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Renode: Prepare & Run Single Node",
      "dependsOn": ["Renode: cleanup", "Make: rebuild", "Renode: start single node"],
      "dependsOrder": "sequence"
    }
  ]
}