:name: STM32F103 eVCU Training Network
:description: eVCU OSEK ELF + Diagnostic ECU + COM ECU on one virtual CAN hub.

emulation CreateCANHub "canHub"

# ========================================================
# NODE 1: eVCU under test
# ========================================================
mach create "eVCU"
machine LoadPlatformDescription @Platform/Debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend $ORIGIN/../tool/logs/evcu_uart.log true
sysbus LoadELF @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/DiagECU/tool/evcu.elf
machine StartGdbServer 3334

# ========================================================
# NODE 2: student-style diagnostic ECU, UDS over CAN TP
# ========================================================
mach create "Diag_ECU"
machine LoadPlatformDescription @Platform/Debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend $ORIGIN/../tool/logs/diag_uart.log true
sysbus LoadELF @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/DiagECU/DiagECU.elf
machine StartGdbServer 3333

# ========================================================
# NODE 3: student-style COM ECU, AUTOSAR COM over CAN
# ========================================================
mach create "Com_ECU"
machine LoadPlatformDescription @Platform/Debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend $ORIGIN/../tool/logs/com_uart.log true
sysbus LoadELF @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/ComECU/ComECU.elf
machine StartGdbServer 3335

logLevel 3 sysbus
echo "eVCU training network ready: eVCU(:3334), Diag_ECU(:3333), Com_ECU(:3335)"
start