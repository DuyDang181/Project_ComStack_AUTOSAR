:name: Dynamic eVCU Test Network
emulation CreateCANHub "canHub"

mach create "eVCU"
machine LoadPlatformDescription @Platform/Debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/DiagECU/tool/logs/evcu_uart.log true
sysbus LoadELF @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/DiagECU/tool/evcu.elf
machine StartGdbServer 3333

mach create "Diag_ECU"
machine LoadPlatformDescription @Platform/Debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/DiagECU/tool/logs/diag_uart.log true
sysbus LoadELF @D:/DUY_DANG/PROJECT/Project_ComStack_AUTOSAR/DiagECU/DiagECU.elf
machine StartGdbServer 3334

logLevel 3 sysbus
start
